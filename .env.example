# Environment Variables for Stock Trader
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!

# Gmail App Password (for email notifications)
# Get it from: https://myaccount.google.com/security
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Telegram Bot Token (for instant messages)
# Get it from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Firebase Credentials (for cloud database)
# Download from Firebase Console and paste JSON here
FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}